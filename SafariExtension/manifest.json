{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "0.1.4",
  "description": "__MSG_extension_description__",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "persistent": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_action_title__"
  },
  "icons": {
    "128": "icon128.png"
  },
  "default_locale": "en"
}
