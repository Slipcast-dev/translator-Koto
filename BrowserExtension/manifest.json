{
  "manifest_version": 3,
  "name": "Koto — Slipcast-Dev",
  "version": "0.1.1",
  "description": "Перевод выделения и видимой страницы через Koto на вашем Mac.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Koto"
  },
  "icons": {
    "128": "icon128.png"
  }
}
